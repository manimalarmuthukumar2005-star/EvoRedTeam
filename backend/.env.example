# ==============================================================================
# EvoRedTeam Laboratory — Environment Configuration
# ==============================================================================

# Server Security & JWT
JWT_SECRET_KEY=dev_secret_key_change_in_production_e9f8a3c2b1d0
ENVIRONMENT=development
DATA_DIR=data/experiments

# ------------------------------------------------------------------------------
# Provider API Keys (Optional — Leave blank to run local simulation engine)
# ------------------------------------------------------------------------------
# OpenAI (e.g. gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
OPENAI_API_KEY=

# Anthropic Claude (e.g. claude-3-5-sonnet-20241022, claude-3-haiku-20240307)
ANTHROPIC_API_KEY=

# Google Gemini (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_API_KEY=

# Groq (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Model ID Overrides (Optional Defaults)
# ------------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# Real Password Reset & Transactional Email Settings
# ------------------------------------------------------------------------------
# Option A: Standard SMTP (Gmail, Outlook, Amazon SES, SendGrid SMTP, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=no-reply@evoredteam.lab

# Option B: Resend / HTTP REST Email API
EMAIL_PROVIDER_API_KEY=

# Base URL for Password Reset Links
APP_BASE_URL=http://localhost:5173

